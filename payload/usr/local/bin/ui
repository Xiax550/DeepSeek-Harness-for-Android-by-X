#!/usr/bin/env node
/**
 * ui — look at, and act on, the phone's screen from inside the sandbox.
 *
 *   ui status                      # 无障碍、ADB、输入通道和悬浮球状态
 *   ui tree [--text]               # 当前屏幕上的可点/可输入控件（默认只列交互控件）
 *   ui click "发送"                 # 按文字点，比坐标稳
 *   ui tap 540 1200                # 按坐标点（坐标由 tree 给出）
 *   ui type "你好"                  # 往当前输入框输入
 *   ui key back|home|recents|notifications|lock
 *   ui swipe 540 1800 540 600 300  # 起点终点与时长(ms)
 *   ui open 微信                    # 按应用名或包名启动
 *   ui ball start|stop             # 悬浮球开关
 *   ui virtual on|off              # 启用或关闭虚拟副屏
 *   ui backend auto|accessibility|adb
 *
 * `ui` picks the best available path for each action. Direct taps, swipes and
 * keys use Shizuku's adb-shell input when granted; semantic reads, label clicks
 * and text use accessibility first. Auto mode falls back to the other channel.
 *
 * Exit codes: 0 ok, 1 the action failed (message on stderr), 2 bridge/protocol trouble.
 */
import { existsSync, readFileSync, writeFileSync } from "node:fs";

const BRIDGE_EXIT = 2;

function findBridge() {
  const url = process.env.DSH_ANDROID_BRIDGE_URL;
  const token = process.env.DSH_ANDROID_BRIDGE_TOKEN;
  if (url && token) return { url, token };
  for (const path of ["/etc/dsh-android/bridge.env", "/root/.dsh-android-bridge.env"]) {
    if (!existsSync(path)) continue;
    const values = {};
    for (const line of readFileSync(path, "utf8").split("\n")) {
      const match = /^\s*([A-Z_]+)\s*=\s*(.*)\s*$/.exec(line);
      if (match) values[match[1]] = match[2].replace(/^["']|["']$/g, "");
    }
    if (values.DSH_ANDROID_BRIDGE_URL && values.DSH_ANDROID_BRIDGE_TOKEN) {
      return { url: values.DSH_ANDROID_BRIDGE_URL, token: values.DSH_ANDROID_BRIDGE_TOKEN };
    }
  }
  console.error("ui: 找不到控制桥（DSH_ANDROID_BRIDGE_URL/TOKEN，或 /etc/dsh-android/bridge.env）");
  process.exit(BRIDGE_EXIT);
}

async function call(path, body) {
  const bridge = findBridge();
  const response = await fetch(bridge.url + path, {
    method: body === undefined ? "GET" : "POST",
    headers: Object.assign({ "X-Dsh-Token": bridge.token },
      body === undefined ? {} : { "Content-Type": "application/json" }),
    body: body === undefined ? undefined : JSON.stringify(body),
  });
  const text = await response.text();
  let data;
  try {
    data = text ? JSON.parse(text) : {};
  } catch {
    console.error("ui: 桥的响应不是 JSON：" + text.slice(0, 200));
    process.exit(BRIDGE_EXIT);
  }
  return data;
}

function fail(message) {
  console.error("ui: " + message);
  process.exit(1);
}

/** Nodes the model can act on, one per line: what it is, where, what it can do. */
function renderTree(data) {
  if (data.ok !== true) fail(data.error || "读不到屏幕");
  const backend = data.backend === "adb" ? "ADB" : "无障碍";
  const lines = [`# ${data.package || "?"}（${data.count} 个可操作控件，通道：${backend}）`];
  for (const node of data.nodes ?? []) {
    const can = (node.can ?? []).join(",");
    const at = (node.at ?? []).join(",");
    const text = node.text ? JSON.stringify(node.text) : "";
    const id = node.id ? "#" + node.id : "";
    lines.push(`  [${at}] ${node.class}${id} ${can} ${text}`.trimEnd());
  }
  return lines.join("\n");
}

function actionResult(data, fallback) {
  if (data?.ok === false) fail(data.error || data.message || fallback);
  const backend = data?.backend === "adb" ? " [ADB]"
    : data?.backend === "accessibility" ? " [无障碍]" : "";
  console.log((data?.message ?? fallback) + backend);
}

async function main() {
  const argv = process.argv.slice(2);
  const command = argv[0];
  const rest = argv.slice(1);

  switch (command) {
    case "status": {
      const state = await call("/a11y/status");
      const input = state.input ?? {};
      const requested = input.requested ?? state.inputBackend ?? "auto";
      const effective = input.effective ?? state.effectiveInputBackend ?? "unavailable";
      const modeName = requested === "accessibility" ? "仅无障碍"
        : requested === "adb" ? "仅 ADB" : "自动选择";
      const activeName = effective === "accessibility" ? "无障碍"
        : effective === "adb" ? "ADB（Shizuku，触摸优先）" : "不可用";
      console.log([
        `无障碍服务：${state.service ? "已开启" : "未开启"}`,
        `Shizuku/ADB：${input.adbGranted === true ? (input.virtualDisplayActive === true ? "已授权，坐标操作可用于虚拟副屏" : "已授权") : input.adbInstalled === true ? "已安装，未授权" : "不可用"}`,
        `输入通道：${modeName}（当前 ${activeName}）`,
        `悬浮窗权限：${state.overlay ? "已允许" : "未允许"}`,
        `麦克风：${state.microphone ? "已允许" : "未允许"}`,
        `悬浮球：${state.ball ? "开着" : "关着"}`,
        `屏幕：${state.screen || "?"}`,
      ].join("\n"));
      const noRequiredChannel = requested === "accessibility" ? state.service !== true
        : requested === "adb" ? input.adbGranted !== true
          : state.service !== true && input.adbGranted !== true;
      if (noRequiredChannel) {
        console.error("提示：当前固定通道不可用，请在 设置 → 安卓沙箱 中检查权限");
      }
      return;
    }
    case "tree":
      console.log(renderTree(await call("/a11y/tree", { text: rest.includes("--text") })));
      return;
    case "screenshot": {
      const data = await call("/a11y/screenshot", {});
      if (data.ok !== true || typeof data.base64 !== "string") {
        fail(data.error || "无法通过无障碍截屏");
      }
      const target = rest[0] || "/sdcard/Download/dha-screen.png";
      writeFileSync(target, Buffer.from(data.base64, "base64"));
      const note = await call("/task/images/note", { path: target });
      if (note.active === true && note.tracked !== true) {
        console.error("ui: 截图已写入，但当前任务无法自动清理这个路径；请改用 /sdcard/Download/...");
      }
      const size = data.width && data.height ? ` (${data.width}x${data.height})` : "";
      console.log(target + size);
      return;
    }
    case "tap": {
      const [x, y] = rest.map(Number);
      if (!Number.isFinite(x) || !Number.isFinite(y)) fail("用法：ui tap <x> <y>（坐标从 ui tree 里取）");
      actionResult(await call("/a11y/tap", { x, y }), "已点击");
      return;
    }
    case "click": {
      if (!rest.length) fail('用法：ui click "<控件上的文字>"');
      actionResult(await call("/a11y/click", { label: rest.join(" ") }), "已点击");
      return;
    }
    case "type": {
      if (!rest.length) fail('用法：ui type "<要输入的内容>"');
      actionResult(await call("/a11y/type", { text: rest.join(" ") }), "已输入");
      return;
    }
    case "key": {
      actionResult(await call("/a11y/key", { name: rest[0] ?? "" }), "按键已发送");
      return;
    }
    case "swipe": {
      const [x1, y1, x2, y2, ms] = rest.map(Number);
      if ([x1, y1, x2, y2].some((value) => !Number.isFinite(value))) {
        fail("用法：ui swipe <x1> <y1> <x2> <y2> [ms]");
      }
      actionResult(await call("/a11y/swipe", {
        x1, y1, x2, y2, ms: Number.isFinite(ms) ? ms : 300
      }), "已滑动");
      return;
    }
    case "backend": {
      const mode = rest[0] ?? "";
      if (!["auto", "accessibility", "adb"].includes(mode)) {
        fail("用法：ui backend <auto|accessibility|adb>");
      }
      const result = await call("/a11y/backend", { mode });
      console.log(result.message ?? "输入通道已更新");
      return;
    }
    case "virtual": {
      const action = rest[0] ?? "";
      if (action !== "on" && action !== "off") {
        fail("用法：ui virtual <on|off>");
      }
      const result = await call("/settings", { virtualDisplay: action === "on" });
      if (result?.ok === false) fail(result.error ?? result.message ?? "虚拟副屏切换失败");
      console.log(result.message ?? (action === "on" ? "虚拟副屏已启用" : "虚拟副屏已关闭"));
      return;
    }
    case "open": {
      if (!rest.length) fail('用法：ui open "<应用名或包名>"');
      console.log((await call("/a11y/open", { app: rest.join(" ") })).message ?? "ok");
      return;
    }
    case "ball": {
      console.log((await call(rest[0] === "stop" ? "/ball/stop" : "/ball/start", {})).message ?? "ok");
      return;
    }
    case "watch": {
      if (rest[0] === "enable" || rest[0] === "disable") {
        const answer = await call("/ball/settings", { screenWatchEnabled: rest[0] === "enable" });
        console.log(answer.message ?? (rest[0] === "enable" ? "屏幕变化观察已启用" : "屏幕变化观察已停用"));
        return;
      }
      if (rest[0] === "minutes") {
        const minutes = Number(rest[1]);
        if (!Number.isInteger(minutes) || minutes < 1 || minutes > 1440) {
          fail("用法：ui watch minutes <1-1440>");
        }
        await call("/ball/settings", { screenWatchMinutes: minutes });
        console.log("屏幕变化观察自动退出时间：" + minutes + " 分钟");
        return;
      }
      const action = rest[0] === "stop" ? "stop" : rest[0] === "start" ? "start" : "toggle";
      console.log((await call(`/screen-watch/${action}`, {})).message ?? "ok");
      return;
    }
    case "permission": {
      const which = rest[0];
      const path = which === "overlay" ? "/overlay/request"
        : which === "mic" ? "/mic/request" : "/a11y/request";
      console.log((await call(path, {})).message ?? "ok");
      return;
    }
    default:
      console.log(`ui — 自动选择无障碍或 ADB 来读取、点击和输入

  ui status                      当前通道、Shizuku、悬浮窗、麦克风和屏幕尺寸
  ui tree [--text]               屏幕上的控件；--text 连纯文本一起列
  ui screenshot [path]           无障碍截屏（Android 11+，默认 /sdcard/Download/dha-screen.png）
  ui click "发送"                 按文字点（推荐）
  ui tap X Y                     按坐标点
  ui type "内容"                  输入到当前输入框
  ui key <back|home|recents|notifications|lock>
  ui swipe X1 Y1 X2 Y2 [ms]      滑动
  ui backend auto|accessibility|adb  切换输入通道
  ui virtual on|off              启用或关闭虚拟副屏
  ui open "微信"                  启动应用
  ui ball start|stop             悬浮球开关
  ui watch [start|stop]          开始、停止或切换屏幕变化观察
  ui watch enable|disable        启用或停用悬浮输入栏中的观察按钮
  ui watch minutes N             设置自动退出时间（1–1440 分钟）
  ui permission [a11y|overlay|mic]  让应用弹出相应的授权页`);
  }
}

main().catch((error) => {
  console.error("ui: " + (error && error.message ? error.message : String(error)));
  process.exit(BRIDGE_EXIT);
});
